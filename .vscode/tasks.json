{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Debug",
      "type": "shell",
      "command": "${workspaceFolder}\\.vscode\\scripts\\build.bat",
      "args": ["Debug"],
      "group": {
        "kind": "build"
      },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Release",
      "type": "shell",
      "command": "${workspaceFolder}\\.vscode\\scripts\\build.bat",
      "args": ["Release"],
      "group": {
        "kind": "build"
      },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "${workspaceFolder}\\.vscode\\scripts\\build.bat",
      "args": ["Debug", "test"],
      "group": {
        "kind": "build"
      },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\scripts\\clean.ps1"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      }
    }
  ]
}
