#include <winres.h>
#include "version.h"

IDI_ICON1 ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MSFS Flight Data Recorder"
            VALUE "FileVersion", APP_VERSION
            VALUE "InternalName", "MSFS-Flight-Data-Recorder"
            VALUE "OriginalFilename", "MSFS-Flight-Data-Recorder.exe"
            VALUE "ProductName", "MSFS Flight Data Recorder"
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
